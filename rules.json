    "docker-root-user": "config",
    "docker-sensitive-copy": "config",
    "shell-missing-strict": "config",
    "shell-dangerous-rm": "config"
  },
  "thresholds": {
    "long_function_lines": 80,
    "many_args_count": 6,
    "deep_nesting_levels": 4,
    "line_length_limit": 120
  },
  "allowlist": {
    "dirs": [
      ".git",
      "__pycache__",
      ".pytest_cache",
      ".ruff_cache",
      ".venv",
      "venv",
      "env",
      ".env",
      "node_modules",
      "dist",
      "build",
      ".mypy_cache",
      ".tox",
      ".eggs",
      "site-packages",
      "repros",
      "fixes"
    ],
    "files": [
      "report.json",
      "report.md",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml"
    ],
    "extensions": [
      ".py",
      ".pyi",
      ".js",
      ".jsx",
      ".ts",
      ".tsx",
      ".mjs",
      ".cjs",
      ".json",
      ".yaml",
      ".yml",
      ".toml",
      ".html",
      ".htm",
      ".css",
      ".scss",
      ".sh",
      ".bash",
      "Dockerfile"
    ]
  }
}

    "trailing-whitespace": "cosmetic",
    "mixed-indentation": "cosmetic",
    "missing-final-newline": "cosmetic",
    "line-too-long": "cosmetic",
    "identifier-typo": "cosmetic",
    "comment-typo": "cosmetic",
    "unused-import": "cosmetic",
    "unused-variable": "cosmetic",
    "commented-out-code": "cosmetic",
    "long-function": "cosmetic",
    "many-args": "cosmetic",
    "deep-nesting": "cosmetic",
    "todo-marker": "cosmetic",
    "print-in-prod": "cosmetic",
    "duplicate-import": "cosmetic",
    "unnecessary-pass": "cosmetic",
    "js-loose-equality": "multilang",
    "js-debugger-statement": "multilang",
    "js-eval-usage": "multilang",
    "html-img-missing-alt": "multilang",
    "html-empty-href": "multilang",
    "html-inline-event-handler": "multilang",
    "css-empty-ruleset": "multilang",
    "css-invalid-hex-color": "multilang",

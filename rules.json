{
  "$schema": "vcc-rules-v2",
  "version": "2.0.0",
  "name": "Vibe Code Checker Production Rules",
  "comment": "Configurable severity, thresholds, and filters for Vibe Code Checker.",
  "severity": {
    "syntax-error": "P0",
    "undefined-name": "P0",
    "unbound-local": "P0",
    "eval-exec": "P0",
    "command-injection": "P0",
    "sql-injection": "P0",
    "path-traversal": "P0",
    "bare-except": "P0",
    "zero-div": "P0",
    "float-nan-compare": "P0",

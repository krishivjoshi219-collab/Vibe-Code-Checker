    "off-by-one-index": "P0",
    "duplicate-dict-key": "P0",
    "raise-non-exception": "P0",

    "mutable-default": "P1",
    "missing-return-branch": "P1",
    "dead-code": "P1",
    "silent-except-pass": "P1",
    "broad-except": "P1",
    "db-connection-leak": "P1",
    "file-leak-no-with": "P1",
    "no-commit-after-write": "P1",
    "httpx-no-timeout": "P1",
    "blocking-call-in-async": "P1",
    "weak-random": "P1",
    "weak-hash": "P1",
    "identity-compare-literal": "P1",
    "none-deref-risk": "P1",
    "redefined-function": "P1",
    "builtin-shadow": "P1",
    "global-mutation": "P1",
    "infinite-loop-risk": "P1",
    "assert-on-tuple": "P1",
    "re-raise-reset-traceback": "P1",
    "cors-wildcard": "P1",
    "js-loose-equality": "P1",
    "js-debugger-statement": "P1",
    "js-eval-usage": "P1",
    "docker-latest-tag": "P1",
    "docker-root-user": "P1",
    "docker-sensitive-copy": "P1",
    "shell-missing-strict": "P1",
    "shell-dangerous-rm": "P1",

    "none-eq-compare": "P2",
    "bool-compare": "P2",
    "trailing-whitespace": "P2",
    "mixed-indentation": "P2",
    "missing-final-newline": "P2",
    "line-too-long": "P2",
    "identifier-typo": "P2",
    "comment-typo": "P2",
    "unused-import": "P2",
    "unused-variable": "P2",
    "commented-out-code": "P2",
    "long-function": "P2",
    "many-args": "P2",
    "deep-nesting": "P2",
